# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional live payment gateway credentials.
# When omitted, checkout operates in clearly labeled Test Mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# FIREBASE_SERVICE_ACCOUNT_JSON & FIRESTORE_DATABASE_ID: Server-side only (never expose as VITE_*).
# Required for server-side atomic stock deduction, verified review purchase checks, and Super Admin seeding.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIRESTORE_DATABASE_ID="ai-studio-d0e3e2f7-b403-4c3f-b56f-ef8a804ed3d0"
